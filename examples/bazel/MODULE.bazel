use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

undra = use_extension("@undra_rules//:extensions.bzl", "undra")
undra.source(path = "../..")
# The standard library of the Android targets, for `undra_core(platforms = ["android"])`: the release of rust.toolchain above, by checksum.
undra.android_std(
    version = "1.99.0",
    sha256s = {
        "aarch64-linux-android": "41201595138e99645ac1db279719958ad3ca9d379f33576497f8cc644d885163",
        "x86_64-linux-android": "eaca047713cdd82b0a21dea767a6a3a018fc4039ae4500ee55211edd7cba251c",
    },
)
use_repo(undra, "undra", "undra_android_std", "undra_binaryen", "undra_vendor")

# The Android NDK, as a label (ADR-065): `undra_core(ndk = ..)` takes the files of an NDK as an input of the build, so nothing of
# the machine's is read (`ANDROID_NDK_HOME`, `--action_env` and `extra_path` are not involved). The archive is per host OS (`//:mobile_android`
# selects), and it is fetched only by a build that needs it (`bazel build //:mobile_android`), never by `bazel test //...`.
# `android/use-installed-ndk.sh` stands the NDK that `sdkmanager` installed in for these two, which is what CI does.
#
# NDK r27c (27.2.12479018, the version the CI installs), pinned by the SHA-256 of each archive.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "android_ndk_linux",
    build_file = "//android:ndk.BUILD",
    sha256 = "59c2f6dc96743b5daf5d1626684640b20a6bd2b1d85b13156b90333741bad5cc",
    strip_prefix = "android-ndk-r27c",
    urls = ["https://dl.google.com/android/repository/android-ndk-r27c-linux.zip"],
)

http_archive(
    name = "android_ndk_macos",
    build_file = "//android:ndk.BUILD",
    sha256 = "8c5685457c58a88527367d46d3f14e8c727d962c39f85344cff0c0768a73c3b7",
    strip_prefix = "android-ndk-r27c",
    urls = ["https://dl.google.com/android/repository/android-ndk-r27c-darwin.zip"],
)

# Node, which the TypeScript test runs on (the TypeScript compiler is undra_rules's: typescript.deps(version = "5.9.3")).
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.18.0")

# The Xcode project of the iOS app (//ios:xcodeproj), for debugging the core from Xcode and lldb (macOS; the target is `manual`).
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")
