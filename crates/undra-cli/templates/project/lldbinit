# LLDB's startup file for this project, written by `undra init` (ADR-046): it loads the Rust formatters of the toolchain
# on this machine (`rustc --print sysroot`), so Rust values (String, Vec, Option, ...) read as values when you step into
# the core from Xcode or `lldb`, and says nothing when the toolchain has none.
#
# LLDB reads a project's .lldbinit only from the directory it starts in, and only when told it may:
#   echo 'settings set target.load-cwd-lldbinit true' >> ~/.lldbinit
# Then, in the Xcode console or `lldb` started here, set a breakpoint on a Rust line and step in from Swift:
#   breakpoint set -f todos.rs -l 42
# Chrome DevTools, Android Studio and `cargo test` have their own pages in docs/ONBOARDING.md ("Debugging into Rust").
script import os, subprocess; root = subprocess.run(["rustc", "--print", "sysroot"], capture_output=True, text=True).stdout.strip() + "/lib/rustlib/etc"; [lldb.debugger.HandleCommand(c) for c in ('command script import "%s/lldb_lookup.py"' % root, 'command source -s 0 "%s/lldb_commands"' % root) if os.path.exists(c.split('"')[1])]
# The struct and enum summaries of the Rust 1.99 formatters follow every pointer field: a `&Runtime` argument in a
# backtrace walks the whole object graph and, through a cycle (`Weak<Runtime>`), recurses until Python aborts LLDB.
# Re-registered with the pointers skipped, a pointer prints as its address (`self=0x...`), as LLDB prints it without
# formatters, and a value keeps its summary (`reason="kaboom"`, `__call={method_id:..., args:size=10}`). Older formatters: nothing.
script import sys; L = sys.modules.get("lldb_lookup"); [L.register_summary(getattr(L, p), lldb.SBTypeNameSpecifier("lldb_lookup." + r, lldb.eFormatterMatchCallback), o | lldb.eTypeOptionSkipPointers | lldb.eTypeOptionSkipReferences) for p, r, o in (("StructSummaryProvider", "is_udt", lldb.eTypeOptionCascade | lldb.eTypeOptionHideEmptyAggregates | lldb.eTypeOptionHideChildren), ("ClangEncodedEnumSummaryProvider", "is_gnu_enum", lldb.eTypeOptionCascade))] if L is not None and hasattr(L, "register_summary") and hasattr(lldb, "eFormatterMatchCallback") else None
# The same formatters match by shape, not by language, so they also print Swift and Objective-C values: a Swift
# frame's `bytes` reads `{[0]:{}, [1]:{}, ...}`, and a Swift object (`self` of `InprocTransport`, a class, so no
# pointer to skip) walks the app's object graph round its cycles until Python aborts LLDB on a `bt` from Rust down
# to the app. Their type recognizers decline Swift and Objective-C types here, which keep LLDB's own formatting.
script import sys; L = sys.modules.get("lldb_lookup"); X = getattr(lldb, "eTypeIsSwift", 0) | lldb.eTypeIsObjC; [setattr(L, n, (lambda f: lambda t, d: not t.GetTypeFlags() & X and f(t, d))(getattr(L, n))) for n in ("is_udt", "is_tuple_type", "is_gnu_enum") if hasattr(L, n)] if L is not None else None
