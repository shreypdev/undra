load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":actions_test.bzl", "actions_test_suite")
load(":bindings_test_test.bzl", "bindings_test_suite")
load(":cargo_vendor_test.bzl", "cargo_vendor_test_suite")

cargo_vendor_test_suite(name = "cargo_vendor_tests")

actions_test_suite(name = "actions_tests")

bindings_test_suite(name = "bindings_tests")

# run.sh refuses an Android standard library whose release is not the toolchain's, naming the tag in MODULE.bazel.
sh_test(
    name = "std_version_test",
    srcs = ["std_version_test.sh"],
    data = ["//undra/private:run.sh"],
)

# The build directory a core keeps with `keep_debug_objects` is free for the next build of the target (its owner file says
# `kept`), and a build without the attribute leaves none. The test's timeout is the hang bound.
sh_test(
    name = "stage_lock_test",
    timeout = "short",
    srcs = ["stage_lock_test.sh"],
    data = ["//undra/private:run.sh"],
)
