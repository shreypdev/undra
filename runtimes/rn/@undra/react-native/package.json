{
  "name": "@undra/react-native",
  "version": "1.0.0-rc.1",
  "description": "Undra for React Native: the native Undra core under a React Native app, through JSI, with the TypeScript runtime's mirror and the generated bindings on top (ADR-038).",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreypdev/undra",
    "directory": "runtimes/rn/@undra/react-native"
  },
  "type": "module",
  "sideEffects": [
    "./src/polyfills.ts",
    "./dist/polyfills.js"
  ],
  "//": "Metro reads the `react-native` condition and field (the TypeScript sources, so an app needs no build step of this package); everything else reads `dist`. The native module is a C++ TurboModule: `UndraReactNative.podspec` for iOS, `android/CMakeLists.txt` through `react-native.config.cjs` for Android, and `codegenConfig` for both; on Android the package is also a Java library (`android/build.gradle`: the Keystore, ConnectivityManager and the app's directories for the default ports, ADR-038 amendment B).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./babel-plugin": "./babel-plugin.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "cpp",
    "!cpp/test",
    "ios",
    "android/CMakeLists.txt",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/src",
    "UndraReactNative.podspec",
    "react-native.config.cjs",
    "babel-plugin.cjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@undra/runtime": "^1.0.0-rc.1",
    "react-native": ">=0.82"
  },
  "codegenConfig": {
    "name": "UndraReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "dev.undra.reactnative"
    },
    "ios": {
      "modules": {
        "UndraNative": {
          "className": "UndraModuleProvider"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:native": "cpp/test/run.sh && android/test/run.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  }
}
