{
  "name": "@undra/runtime",
  "version": "1.2.0",
  "description": "Undra TypeScript runtime: wire format, transports and reactive mirror for Undra cores.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreypdev/undra",
    "directory": "runtimes/ts/@undra/runtime"
  },
  "type": "module",
  "sideEffects": false,
  "//": "SPEC section 13 lists the subpath exports ., ./react, ./vue, ./svelte, ./solid, ./worker, ./vite and ./node. All exist except ./node: the runtime has no node-specific module yet (the Node adapters are the ones in '.', ./realtime and ./db), and no export may point at a stub. ./realtime (WebSocket and Sse) and ./db (Db) are the opt-in ports of ADR-047 and ADR-048, out of the main entry so a hello-world bundle stays under ADR-052's gate; ./db-worker is the dedicated worker of the browser's Db adapter (waSqliteDb), the only module that imports the optional peer wa-sqlite (MIT), which a bundled web app that imports ./db installs because the bundler builds that worker. ./vite is the Vite plugin that runs `undra build --platform web` (Node only, no dependencies, compiled by tsconfig.vite.json because it needs Node's types and the other modules must not). The framework packages and wa-sqlite are optional peer dependencies: @undra/runtime itself imports none of them, each adapter imports only its own.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/dev/index.js",
      "react-native": "./dist/dev/index.js",
      "default": "./dist/index.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "development": "./dist/dev/wire/index.js",
      "react-native": "./dist/dev/wire/index.js",
      "default": "./dist/wire/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "development": "./dist/dev/react.js",
      "react-native": "./dist/dev/react.js",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "development": "./dist/dev/vue.js",
      "react-native": "./dist/dev/vue.js",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "development": "./dist/dev/svelte.js",
      "react-native": "./dist/dev/svelte.js",
      "default": "./dist/svelte.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "development": "./dist/dev/solid.js",
      "react-native": "./dist/dev/solid.js",
      "default": "./dist/solid.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "development": "./dist/dev/worker.js",
      "react-native": "./dist/dev/worker.js",
      "default": "./dist/worker.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "development": "./dist/dev/realtime.js",
      "react-native": "./dist/dev/realtime.js",
      "default": "./dist/realtime.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "development": "./dist/dev/db.js",
      "react-native": "./dist/dev/db.js",
      "default": "./dist/db.js"
    },
    "./db-worker": {
      "types": "./dist/db-worker.d.ts",
      "development": "./dist/dev/db-worker.js",
      "react-native": "./dist/dev/db-worker.js",
      "default": "./dist/db-worker.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "development": "./dist/dev/vite.js",
      "react-native": "./dist/dev/vite.js",
      "default": "./dist/vite.js"
    },
    "./mangle-cache.json": "./dist/mangle-cache.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.6",
    "svelte": ">=4",
    "vue": ">=3.3",
    "wa-sqlite": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "wa-sqlite": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:dist": "node scripts/test-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.vite.json --noEmit"
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "~1.2.9",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "wa-sqlite": "^1.0.0",
    "wabt": "^1.0.39"
  }
}
