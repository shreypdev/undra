{
  "name": "@undra/testkit",
  "version": "1.0.0-rc.1",
  "description": "Undra testing kit for TypeScript: preview cores with deterministic fakes, recorded cores, and port record/replay.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shreypdev/undra",
    "directory": "runtimes/ts/@undra/testkit"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@undra/runtime": "^1.0.0-rc.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  }
}
